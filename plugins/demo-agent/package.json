{
  "name": "@omniterm/demo-agent-plugin",
  "version": "0.0.0",
  "description": "Example omniterm plugin: a coding-agent panel that streams the Claude Agent SDK and shows the agent's live Playwright browser (CDP) beside the chat.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:client": "vite build",
    "build:server": "tsup",
    "build": "pnpm run build:client && pnpm run build:server",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.117",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@omniterm/plugin-types": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}

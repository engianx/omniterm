{
  "name": "@omniterm/core",
  "version": "0.1.6",
  "description": "omniterm SDK \u2014 the host shell, built-in terminal plugin, browser registry, and workspace/file management. Private; bundled into @omniterm/host (and any host) via tsup.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "omniterm-browser": "bin/omniterm-browser.js"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./lib/*.js": "./lib/*.ts",
    "./lib/*": "./lib/*",
    "./plugins/terminal/integration": "./plugins/terminal/integration.tsx",
    "./plugins/*.js": "./plugins/*.ts",
    "./plugins/*": "./plugins/*",
    "./browserRegistry/TabBrowserView": "./browserRegistry/TabBrowserView.tsx",
    "./browserRegistry/*.js": "./browserRegistry/*.ts",
    "./browserRegistry/*": "./browserRegistry/*",
    "./app/page": "./app/page.tsx",
    "./app/globals.css": "./app/globals.css",
    "./app/*": "./app/*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "bin/",
    "dist/",
    "standalone/",
    "public/"
  ],
  "scripts": {
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "build": "pnpm run build:client && pnpm run build:server",
    "prepublishOnly": "pnpm run build",
    "test": "NODE_ENV=test tsx --test '**/*.test.ts' --test-skip-pattern=node_modules",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@omniterm/plugin-types": "workspace:*",
    "@tanstack/react-virtual": "^3.13.24",
    "codemirror": "^6.0.2",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "ignore": "^7.0.5",
    "marked": "^18.0.3",
    "posthog-node": "^5.37.0"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^24.12.4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.7",
    "pdfjs-dist": "^5.7.284",
    "playwright-core": "^1.60.0",
    "react": "^18",
    "react-dom": "^18",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
